[Unit]
Description=Horus message relay (store-and-forward queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HORUS_RELAY_ADDR=0.0.0.0:8787
Environment=HORUS_RELAY_TTL_SECS=604800
Environment=HORUS_RELAY_STATE=/var/lib/horus/relay_state.json
ExecStart=/usr/local/bin/horus-msg-relay
WorkingDirectory=/var/lib/horus
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/horus
MemoryMax=512M

[Install]
WantedBy=multi-user.target
